# ------------------------------------------------------------------
# Text files: normalise to LF, keep Unity YAML diffable
# ------------------------------------------------------------------
* text=auto eol=lf

*.cs            text diff=csharp
*.unity         filter=lfs diff=lfs merge=lfs -text
*.prefab        text
*.mat           text
*.anim          text
*.controller    text
*.overrideController text
*.mask          text
*.physicMaterial text
*.physicsMaterial2D text
*.meta          text
*.asmdef        text
*.asmref        text
*.json          text
*.md            text
*.txt           text
*.xml           text
*.yml           text
*.yaml          text
*.csv           text
*.shader        text
*.hlsl          text
*.cginc         text
*.compute       text
*.uxml          text
*.uss           text
*.inputactions  text
*.preset        text
*.rsp           text

